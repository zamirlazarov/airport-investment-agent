# Copy to .env.local and set ONE of the keys below. The first one that is set is used.

# 1. Vercel AI Gateway (recommended): chat and voice.
#    https://vercel.com/docs/ai-gateway/authentication-and-byok
AI_GATEWAY_API_KEY=

# 2. Anthropic directly: chat only; voice falls back to the browser's built-in speech.
ANTHROPIC_API_KEY=

# 3. OpenAI directly: chat only; voice falls back to the browser's built-in speech.
OPENAI_API_KEY=
