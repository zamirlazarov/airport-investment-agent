# Copy to .env.local, then set ONE API key and, optionally, AGENT_MODEL.

# Which model the agent uses, as "provider/model". Optional.
#   Default: anthropic/claude-haiku-5.5 (OpenAI key only: openai/gpt-6-luna-fast).
#   With AI_GATEWAY_API_KEY any model in the catalog works: https://vercel.com/ai-gateway/models
#   With a direct key (below) the model must be from that provider.
# Examples: anthropic/claude-sonnet-5.5, anthropic/claude-opus-5.5, openai/gpt-5.4
AGENT_MODEL=

# 1. Vercel AI Gateway (recommended): any model, and voice (ElevenLabs).
#    https://vercel.com/docs/ai-gateway/authentication-and-byok
AI_GATEWAY_API_KEY=

# 2. Anthropic directly: Anthropic models only; voice uses the browser's built-in speech.
ANTHROPIC_API_KEY=

# 3. OpenAI directly: OpenAI models only; voice uses the browser's built-in speech.
OPENAI_API_KEY=
